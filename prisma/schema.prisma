// DiasporaTrust Authoritative PostgreSQL Database Schema (Prisma ORM)
// Compliant with Section 12 of DiasporaTrust Product Architecture

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// A. IDENTITY, ROLES & ACCESS CONTROL
// ----------------------------------------------------

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserRoleType {
  DIASPORA_CLIENT
  ADMIN_OPERATIONS
  PROJECT_MANAGER
  FINANCE_OFFICER
  FIELD_ENGINEER
  VENDOR_CONTRACTOR
  COMPLIANCE_OFFICER
}

enum KycStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum KycTier {
  TIER_1_BASIC      // Basic ID & Email
  TIER_2_STANDARD   // Govt ID (Passport/NIN), BVN, Proof of Diaspora Address
  TIER_3_ENHANCED   // Source of Wealth / Funds verification for > $50k
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  normalizedEmail   String            @unique
  passwordHash      String
  fullName          String
  phone             String?
  countryOfResidence String
  cityOfResidence   String?
  accountStatus     AccountStatus     @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?
  twoFactorEnabled  Boolean           @default(false)
  twoFactorSecret   String?
  lastLoginAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  roles             UserRole[]
  clientProfile     ClientProfile?
  vendorProfile     VendorProfile?
  kycCases          KycCase[]
  auditLogs         AuditLog[]
  sessions          Session[]
  notifications     Notification[]
  adminApprovals    AdministrativeApproval[]
}

model Role {
  id          String         @id @default(uuid())
  name        UserRoleType   @unique
  description String
  createdAt   DateTime       @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  assignedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Permission {
  id          String           @id @default(uuid())
  action      String           // e.g. "mandates:approve", "ledger:post", "payout:dual_auth"
  resource    String           // e.g. "financial_ledger", "milestones", "projects"
  description String
  roles       RolePermission[]

  @@unique([action, resource])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  tokenHash    String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KycCase {
  id               String       @id @default(uuid())
  userId           String
  tier             KycTier      @default(TIER_1_BASIC)
  status           KycStatus    @default(NOT_SUBMITTED)
  bvnHash          String?
  ninHash          String?
  passportNumber   String?
  idCountry        String?
  idExpiryDate     DateTime?
  addressVerified  Boolean      @default(false)
  reviewerNotes    String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents        KycDocumentReference[]
}

model KycDocumentReference {
  id          String   @id @default(uuid())
  kycCaseId   String
  docType     String   // "PASSPORT", "UTILITY_BILL", "NIN_SLIP", "PROOF_OF_FUNDS"
  storageKey  String
  fileHash    String
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  kycCase     KycCase  @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// B. CLIENTS & MANDATE MANAGEMENT
// ----------------------------------------------------

enum MandateStatus {
  DRAFT
  AWAITING_CLIENT_ACCEPTANCE
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ServiceCategory {
  REAL_ESTATE_LAND
  CONSTRUCTION_MANAGEMENT
  AGRICULTURAL_OPERATIONS
  CONSULTATION_ADVISORY
}

model ClientProfile {
  id                  String         @id @default(uuid())
  userId              String         @unique
  preferredCurrency   String         @default("USD")
  riskTolerance       String?
  taxResidency        String?
  accountManagerId    String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mandates            ClientMandate[]
}

model ClientMandate {
  id                 String          @id @default(uuid())
  referenceNumber    String          @unique // e.g. "DT-MAN-2026-0042"
  clientProfileId    String
  serviceCategory    ServiceCategory
  title              String
  scopeDescription   String
  status             MandateStatus   @default(DRAFT)
  currency           String          @default("USD")
  estimatedBudget    Decimal         @db.Decimal(18, 2)
  platformFeePercent Decimal         @default(5.00) @db.Decimal(5, 2)
  fixedRetainerFee   Decimal         @default(0.00) @db.Decimal(18, 2)
  assignedManagerId  String?
  startDate          DateTime?
  targetEndDate      DateTime?
  acceptedAt         DateTime?
  clientSignature    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  clientProfile      ClientProfile   @relation(fields: [clientProfileId], references: [id])
  projects           Project[]
  invoices           Invoice[]
  contracts          EngagementContract[]
  statusHistory      MandateStatusHistory[]
}

model MandateStatusHistory {
  id           String        @id @default(uuid())
  mandateId    String
  fromStatus   MandateStatus
  toStatus     MandateStatus
  reason       String?
  changedById  String
  createdAt    DateTime      @default(now())

  mandate      ClientMandate @relation(fields: [mandateId], references: [id], onDelete: Cascade)
}

model EngagementContract {
  id            String        @id @default(uuid())
  mandateId     String
  versionNumber Int           @default(1)
  contractTerms String
  documentHash  String
  storageKey    String
  signedAt      DateTime?
  createdAt     DateTime      @default(now())

  mandate       ClientMandate @relation(fields: [mandateId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// C. PROJECTS & BUDGETS
// ----------------------------------------------------

enum ProjectType {
  LAND_ACQUISITION
  CONSTRUCTION
  AGRICULTURE
  CONSULTATION_DELIVERY
}

enum ProjectStatus {
  PLANNING
  ACTIVE_EXECUTION
  PENDING_INSPECTION
  ON_HOLD
  COMPLETED
  DISPUTED
}

model Project {
  id              String         @id @default(uuid())
  projectCode     String         @unique // e.g. "DT-PRJ-LK-008"
  mandateId       String
  projectType     ProjectType
  title           String
  locationState   String         // e.g. "Lagos", "Ogun", "Oyo", "Abuja FCT"
  locationCity    String
  siteAddress     String?
  gpsLatitude     Decimal?       @db.Decimal(10, 8)
  gpsLongitude    Decimal?       @db.Decimal(11, 8)
  status          ProjectStatus  @default(PLANNING)
  currency        String         @default("NGN")
  approvedBudget  Decimal        @db.Decimal(18, 2)
  committedCapital Decimal       @default(0.00) @db.Decimal(18, 2)
  actualExpenditure Decimal      @default(0.00) @db.Decimal(18, 2)
  startDate       DateTime?
  targetEndDate   DateTime?
  leadEngineerId  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  mandate         ClientMandate  @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  milestones      Milestone[]
  mediaAssets     MediaAsset[]
  changeRequests  ProjectChangeRequest[]
  risks           ProjectRisk[]
  disputes        DisputeCase[]
  vendorAssignments VendorProjectAssignment[]

  // Domain specifics
  propertyAsset   PropertyAsset?
  farmSite        FarmSite?
  consultation    ConsultationEngagement?
}

model ProjectChangeRequest {
  id            String   @id @default(uuid())
  projectId     String
  reason        String
  budgetDelta   Decimal  @db.Decimal(18, 2)
  timelineDeltaDays Int  @default(0)
  requestedById String
  approvedById  String?
  isApproved    Boolean  @default(false)
  createdAt     DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectRisk {
  id          String   @id @default(uuid())
  projectId   String
  riskTitle   String
  severity    String   // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  mitigation  String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// D. MILESTONES & VERIFICATION
// ----------------------------------------------------

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED_FOR_REVIEW
  INTERNAL_VERIFIED
  CLIENT_APPROVED
  REJECTED
  DISPUTED
}

model Milestone {
  id                 String           @id @default(uuid())
  projectId          String
  orderIndex         Int
  title              String
  description        String
  acceptanceCriteria String
  allocatedBudget    Decimal          @db.Decimal(18, 2)
  percentProgress    Int              @default(0)
  status             MilestoneStatus  @default(PENDING)
  eligibleForRelease Boolean          @default(false)
  releasePaid        Boolean          @default(false)
  plannedDueDate     DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissions        MilestoneSubmission[]
  verifications      MilestoneVerification[]
  decisions          MilestoneDecision[]
  releaseRequests    MilestoneReleaseRequest[]
}

model MilestoneSubmission {
  id           String    @id @default(uuid())
  milestoneId  String
  submittedById String
  notes        String
  submissionDate DateTime @default(now())

  milestone    Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  mediaAssets  MediaAsset[]
}

model MilestoneVerification {
  id             String    @id @default(uuid())
  milestoneId    String
  verifierUserId String
  decision       String    // "VERIFIED", "REJECTED", "MORE_INFO_NEEDED"
  technicalNotes String
  siteVisitedAt  DateTime?
  gpsVerified    Boolean   @default(false)
  verifiedAt     DateTime  @default(now())

  milestone      Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

model MilestoneDecision {
  id             String    @id @default(uuid())
  milestoneId    String
  clientUserId   String
  decision       String    // "APPROVED", "REJECTED", "DISPUTED"
  clientComments String?
  signatureHash  String?
  decidedAt      DateTime  @default(now())

  milestone      Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// E. REAL ESTATE & TITLE DUE DILIGENCE
// ----------------------------------------------------

enum TitleStatus {
  UNVERIFIED
  DUE_DILIGENCE_IN_PROGRESS
  CLEAN_TITLE_CONFIRMED
  ENCUMBRANCE_FOUND
  DISPUTED_TITLE
}

model PropertyAsset {
  id                 String         @id @default(uuid())
  projectId          String         @unique
  landSizeSqM        Decimal        @db.Decimal(12, 2)
  zoningType         String         // "RESIDENTIAL", "COMMERCIAL", "MIXED_USE", "AGRICULTURAL"
  titleStatus        TitleStatus    @default(UNVERIFIED)
  cadastralSurveyPlan String?
  registryVolume     String?
  registryPage       String?
  governorConsentRef String?
  cOfORefNumber      String?
  sellerFullName     String?
  communityFamilyRep String?
  independentLawyerId String?
  handoverCompletedAt DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dueDiligenceCases  TitleDueDiligenceCase[]
}

model TitleDueDiligenceCase {
  id               String        @id @default(uuid())
  propertyAssetId  String
  assignedCounsel  String
  registrySearched String        // e.g. "Alausa Lands Registry, Ikeja"
  searchFindings   String
  encumbrancesFound String?
  surveyCoordinatesValid Boolean @default(false)
  legalVerdict     String        // "CLEARED_FOR_ACQUISITION", "HIGH_RISK_REJECT", "ADDITIONAL_DOCS_REQUIRED"
  completedAt      DateTime?
  createdAt        DateTime      @default(now())

  propertyAsset    PropertyAsset @relation(fields: [propertyAssetId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// F. AGRICULTURE & FARM MANAGEMENT
// ----------------------------------------------------

enum FarmCycleStatus {
  SOIL_PREPARATION
  PLANTING_INPUTS
  GROWTH_MAINTENANCE
  HARVEST_AGGREGATION
  STORAGE_LOGISTICS
  SALES_SETTLED
}

model FarmSite {
  id              String         @id @default(uuid())
  projectId       String         @unique
  totalHectares   Decimal        @db.Decimal(10, 2)
  soilClassification String?
  waterSource     String         // e.g. "Borehole / Solar Drip Irrigation", "Seasonal Stream"
  farmManagerName String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycles          ProductionCycle[]
  inputs          AgriculturalInput[]
}

model ProductionCycle {
  id               String          @id @default(uuid())
  farmSiteId       String
  cycleCode        String          // e.g. "CSH-2026-A"
  cropOrLivestock  String          // "Cashew", "Cassava", "Poultry (Broilers)", "Maize"
  status           FarmCycleStatus @default(SOIL_PREPARATION)
  seasonYear       Int
  projectedHarvestTons Decimal?    @db.Decimal(10, 2)
  actualHarvestTons   Decimal?     @db.Decimal(10, 2)
  realizedRevenue     Decimal?     @db.Decimal(18, 2)
  cycleStartDate   DateTime
  cycleEndDate     DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  farmSite         FarmSite        @relation(fields: [farmSiteId], references: [id], onDelete: Cascade)
  observations     FieldObservation[]
  salesRecords     AgriculturalSalesRecord[]
}

model AgriculturalInput {
  id           String   @id @default(uuid())
  farmSiteId   String
  inputCategory String   // "FERTILIZER", "HYBRID_SEEDS", "FEED", "IRRIGATION_PARTS"
  itemName     String
  quantity     Decimal  @db.Decimal(10, 2)
  unitCostNgn  Decimal  @db.Decimal(18, 2)
  totalCostNgn Decimal  @db.Decimal(18, 2)
  supplierName String
  invoiceRef   String?
  purchasedAt  DateTime @default(now())

  farmSite     FarmSite @relation(fields: [farmSiteId], references: [id], onDelete: Cascade)
}

model FieldObservation {
  id                String          @id @default(uuid())
  productionCycleId String
  reporterName      String
  cropHealthStatus  String          // "OPTIMAL", "PEST_DETECTED_TREATING", "WATER_STRESS", "HEALTHY"
  observationNotes  String
  weatherCondition  String
  recordedAt        DateTime        @default(now())

  cycle             ProductionCycle @relation(fields: [productionCycleId], references: [id], onDelete: Cascade)
}

model AgriculturalSalesRecord {
  id                String          @id @default(uuid())
  productionCycleId String
  buyerName         String
  metricTonsSold    Decimal         @db.Decimal(10, 2)
  unitPriceNgn      Decimal         @db.Decimal(18, 2)
  grossProceedsNgn  Decimal         @db.Decimal(18, 2)
  deliveryWaypoint  String
  settledAt         DateTime?
  createdAt         DateTime        @default(now())

  cycle             ProductionCycle @relation(fields: [productionCycleId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// G. CONSULTATION & ADVISORY
// ----------------------------------------------------

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  RESCHEDULED
  CANCELLED
}

model ConsultationEngagement {
  id               String            @id @default(uuid())
  projectId        String            @unique
  serviceName      String            // e.g. "Feasibility & Land Due-Diligence Advisory"
  consultantUserId String
  pricingNgn       Decimal           @db.Decimal(18, 2)
  sessionDurationMins Int            @default(60)
  deliverableStatus String           @default("PENDING")
  deliverableDocKey String?
  clientRating     Int?
  clientFeedback   String?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  appointments     ConsultationAppointment[]
}

model ConsultationAppointment {
  id                     String                 @id @default(uuid())
  consultationEngagementId String
  scheduledTime          DateTime
  meetingUrl             String?
  status                 AppointmentStatus      @default(SCHEDULED)
  summaryNotes           String?
  createdAt              DateTime               @default(now())

  engagement             ConsultationEngagement @relation(fields: [consultationEngagementId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// H. VENDORS & CONTRACTORS
// ----------------------------------------------------

enum VendorVerificationStatus {
  PENDING_SUBMISSION
  DOCUMENTS_SUBMITTED
  VERIFIED
  SUSPENDED
  REJECTED
}

model VendorProfile {
  id                 String                  @id @default(uuid())
  userId             String                  @unique
  businessName       String
  cacRegistrationNum String                  @unique // Corporate Affairs Commission Reg No
  taxIdNumber        String?
  specialtyCategory  String                  // "CIVIL_CONTRACTOR", "SURVEYOR", "AGRO_SUPPLIER", "LEGAL"
  verificationStatus VendorVerificationStatus @default(PENDING_SUBMISSION)
  verifiedBankCode   String?
  verifiedAccountNum String?
  accountName        String?
  bankDetailsVerified Boolean                @default(false)
  ratingAverage      Decimal                 @default(5.00) @db.Decimal(3, 2)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments        VendorProjectAssignment[]
  invoices           VendorInvoice[]
}

model VendorProjectAssignment {
  id              String        @id @default(uuid())
  vendorProfileId String
  projectId       String
  roleDescription String
  awardedAmount   Decimal       @db.Decimal(18, 2)
  startDate       DateTime
  completionDate  DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  vendor          VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model VendorInvoice {
  id              String        @id @default(uuid())
  vendorProfileId String
  invoiceNumber   String        @unique
  milestoneRefId  String?
  currency        String        @default("NGN")
  grossAmount     Decimal       @db.Decimal(18, 2)
  taxWithheld     Decimal       @default(0.00) @db.Decimal(18, 2)
  netPayable      Decimal       @db.Decimal(18, 2)
  status          String        @default("SUBMITTED") // "SUBMITTED", "APPROVED", "PAID", "DISPUTED"
  submittedAt     DateTime      @default(now())
  paidAt          DateTime?

  vendor          VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// I. EVIDENCE VAULT & MEDIA ASSETS
// ----------------------------------------------------

model MediaAsset {
  id                    String              @id @default(uuid())
  projectId             String
  milestoneSubmissionId String?
  uploaderUserId        String
  category              String              // "SITE_PHOTO", "DRONE_VIDEO", "INSPECTION_REPORT", "SURVEY_PLAN"
  filename              String
  storageKey            String
  mimeType              String
  fileSize              Int
  sha256Checksum        String
  claimedCaptureTime    DateTime?
  actualUploadTime      DateTime            @default(now())
  gpsLatitude           Decimal?            @db.Decimal(10, 8)
  gpsLongitude          Decimal?            @db.Decimal(11, 8)
  isVerified            Boolean             @default(false)
  verifiedByUserId      String?
  verifiedAt            DateTime?

  project               Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submission            MilestoneSubmission? @relation(fields: [milestoneSubmissionId], references: [id])
}

// ----------------------------------------------------
// J. FINANCIAL ARCHITECTURE & DOUBLE-ENTRY LEDGER
// ----------------------------------------------------

enum AccountType {
  ASSET_CLIENT_SEGREGATED    // 1000 - Held in trust for client engagements
  ASSET_OPERATIONAL_CLEARING // 1010 - Payment gateway in-flight settlement
  LIABILITY_CLIENT_FUNDS     // 2000 - Obligation to client mandates
  LIABILITY_VENDOR_PAYABLE   // 2010 - Obligation to contractors & suppliers
  EQUITY_CAPITAL             // 3000 - Retained earnings / capital
  REVENUE_MANAGEMENT_FEES    // 4000 - Platform 5% service fees realized
  REVENUE_ADVISORY_FEES      // 4010 - Consultation retainers realized
  EXPENSE_BANK_FEES          // 5000 - Payment provider transaction costs
}

enum PaymentIntentStatus {
  CREATED
  AWAITING_PAYMENT
  SETTLEMENT_PROCESSING
  CONFIRMED_SETTLED
  FAILED
  CANCELLED
}

enum ReleaseStatus {
  REQUESTED
  AWAITING_FINANCE_DUAL_AUTH
  APPROVED_FOR_PAYOUT
  PAYOUT_SUBMITTED
  SETTLED
  REJECTED
}

model FinancialAccount {
  id              String         @id @default(uuid())
  accountNumber   String         @unique // e.g. "1000-USD-CLIENT-42"
  accountName     String
  accountType     AccountType
  currency        String         // "NGN", "USD", "GBP"
  cachedBalance   Decimal        @default(0.00) @db.Decimal(18, 2)
  lastReconciledAt DateTime?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  debitEntries    LedgerEntry[]  @relation("DebitAccount")
  creditEntries   LedgerEntry[]  @relation("CreditAccount")
}

model LedgerTransaction {
  id               String        @id @default(uuid())
  transactionRef   String        @unique // e.g. "LTX-2026-99381"
  idempotencyKey   String        @unique
  description      String
  currency         String
  totalAmount      Decimal       @db.Decimal(18, 2)
  postedAt         DateTime      @default(now())
  isReversed       Boolean       @default(false)
  reversedByTxId   String?
  sourceModule     String        // "FUNDING", "MILESTONE_RELEASE", "FEE_COLLECTION", "REFUND"
  sourceReference  String        // e.g. PaymentIntent ID or ReleaseRequest ID

  entries          LedgerEntry[]
}

model LedgerEntry {
  id                  String            @id @default(uuid())
  transactionId       String
  debitAccountId      String
  creditAccountId     String
  amount              Decimal           @db.Decimal(18, 2)
  exchangeRateToNgn   Decimal           @default(1.000000) @db.Decimal(18, 6)
  rateSource          String            @default("CBN_OFFICIAL")
  postedAt            DateTime          @default(now())

  transaction         LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  debitAccount        FinancialAccount  @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount       FinancialAccount  @relation("CreditAccount", fields: [creditAccountId], references: [id])
}

model Invoice {
  id              String         @id @default(uuid())
  invoiceNumber   String         @unique // e.g. "INV-DT-2026-108"
  mandateId       String
  currency        String         @default("USD")
  subtotal        Decimal        @db.Decimal(18, 2)
  platformFee     Decimal        @db.Decimal(18, 2)
  totalDue        Decimal        @db.Decimal(18, 2)
  dueDate         DateTime
  paidAt          DateTime?
  status          String         @default("ISSUED") // "ISSUED", "PAID", "OVERDUE", "VOID"
  createdAt       DateTime       @default(now())

  mandate         ClientMandate  @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  paymentIntents  PaymentIntent[]
}

model PaymentIntent {
  id                 String              @id @default(uuid())
  referenceCode      String              @unique // e.g. "PI-2026-09281"
  invoiceId          String?
  mandateReference   String
  currency           String              // "USD", "GBP", "NGN"
  amount             Decimal             @db.Decimal(18, 2)
  settlementCurrency String              @default("NGN")
  settlementAmount   Decimal             @db.Decimal(18, 2)
  exchangeRate       Decimal             @db.Decimal(18, 6)
  providerName       String              @default("SANDBOX_GATEWAY") // "SANDBOX_GATEWAY", "PAYSTACK", "FLUTTERWAVE", "NIBSS"
  providerTransactionId String?
  status             PaymentIntentStatus @default(CREATED)
  clientIp           String?
  settledAt          DateTime?
  createdAt          DateTime            @default(now())

  invoice            Invoice?            @relation(fields: [invoiceId], references: [id])
}

model MilestoneReleaseRequest {
  id                   String        @id @default(uuid())
  releaseReference     String        @unique // e.g. "REL-2026-0419"
  milestoneId          String
  projectId            String
  vendorProfileId      String
  releaseAmountNgn     Decimal       @db.Decimal(18, 2)
  platformFeeDeduction Decimal       @default(0.00) @db.Decimal(18, 2)
  netDisbursedNgn      Decimal       @db.Decimal(18, 2)
  status               ReleaseStatus @default(REQUESTED)

  // Dual Authorization Controls (Segregation of Duties)
  initiatedByUserId    String
  initiatedAt          DateTime      @default(now())
  financeApprovedByUserId String?
  financeApprovedAt    DateTime?
  rejectionReason      String?

  payoutProviderTxId   String?
  payoutSettledAt      DateTime?

  milestone            Milestone     @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

model RefundRequest {
  id               String   @id @default(uuid())
  refundReference  String   @unique
  paymentIntentId  String
  amount           Decimal  @db.Decimal(18, 2)
  currency         String
  reason           String
  authorizedByUserId String?
  status           String   @default("REQUESTED") // "REQUESTED", "APPROVED", "SETTLED", "REJECTED"
  createdAt        DateTime @default(now())
  settledAt        DateTime?
}

model ReconciliationBatch {
  id                 String    @id @default(uuid())
  batchDate          DateTime
  totalTransactions  Int
  totalDebitsNgn     Decimal   @db.Decimal(18, 2)
  totalCreditsNgn    Decimal   @db.Decimal(18, 2)
  discrepanciesCount Int       @default(0)
  status             String    @default("BALANCED") // "BALANCED", "VARIANCE_FLAGGED"
  reconciledByUserId String
  createdAt          DateTime  @default(now())
}

// ----------------------------------------------------
// K. AUDIT, DISPUTES & NOTIFICATIONS
// ----------------------------------------------------

model AuditLog {
  id           String   @id @default(uuid())
  correlationId String
  actorUserId  String?
  actorEmail   String?
  action       String   // e.g. "MANDATE_CREATED", "MILESTONE_APPROVED", "FINANCE_DUAL_AUTH_GRANTED"
  resourceType String   // e.g. "Milestone", "LedgerTransaction", "KycCase"
  resourceId   String
  ipAddress    String?
  details      Json
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [actorUserId], references: [id])
}

model DisputeCase {
  id             String    @id @default(uuid())
  disputeNumber  String    @unique // e.g. "DSP-2026-0012"
  projectId      String
  raisedByUserId String
  category       String    // "MILESTONE_QUALITY", "BUDGET_OVERRUN", "SURVEY_DISCREPANCY"
  description    String
  status         String    @default("OPEN") // "OPEN", "INVESTIGATING", "MEDIATED_RESOLVED", "ESCALATED"
  resolutionNotes String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AdministrativeApproval {
  id             String    @id @default(uuid())
  actionType     String    // "PAYOUT_RELEASE", "VENDOR_BANK_CHANGE", "BUDGET_EXPANSION"
  targetEntityId String
  firstApproverId String
  secondApproverId String?
  isFullyApproved Boolean  @default(false)
  createdAt      DateTime  @default(now())

  firstApprover  User      @relation(fields: [firstApproverId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
